1. 필요한 패키지 로드하기
# 필요한 패키지 로드하기
from math import log
import numpy as np
2. 빔 탐색 함수
sequences: 현재까지 유지 중인 빔 목록. 각 원소는 [토큰 시퀀스, 점수]
매 시점(row)마다 모든 빔 × 모든 어휘 조합으로 후보를 만들고 점수를 갱신
점수는 이전 점수 × (−log p) 로 계산 → 값이 작을수록 좋은 후보이므로 오름차순 정렬
정렬된 후보 중 상위 beam_size(K)개만 다음 시점으로 넘김
# 빔 탐색 진행
def beam_search(input, beam_size):
    sequences = [[list(), 1.0]]
    for row in input:
        all_candidates = list()
        # 이전 시점까지의 결과를 담아내고 있음
        for i in range(len(sequences)):
            seq, score = sequences[i]
            for j in range(len(row)):
                # 음의 로그를 곱해주는 형태로 스코어 변화
                candidate = [seq + [j], score * -log(row[j])]
                all_candidates.append(candidate)
        # 빔 점수에 대해서 오름차순 정렬
        ordered = sorted(all_candidates, key=lambda tup: tup[1])
        # 빔 크기 K만큼만 참조
        sequences = ordered[:beam_size]
    return sequences
3. 입력 데이터로 빔 탐색 실행
어휘 사전 크기 5, 시퀀스 길이 5인 확률 분포를 직접 만들어 사용합니다. data[t][j] 는 t번째 시점에 j번 단어가 나올 확률입니다.

